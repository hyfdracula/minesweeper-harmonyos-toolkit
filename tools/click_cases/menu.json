        {"act": "tap", "space": "menu", "x": 25.7, "y": 7.7},
        {"act": "expect", "type": "region_light", "min": 230, "region": {"space": "menu", "x": 70, "y": 30, "w": 60, "h": 14}},
        {"act": "tap", "space": "menu", "x": 25.7, "y": 7.7},
        {"act": "expect", "type": "region_dark", "max": 215, "region": {"space": "menu", "x": 70, "y": 30, "w": 60, "h": 14}},
        {"act": "shot", "name": "game_menu_toggle"}
      ]
    },
    {
