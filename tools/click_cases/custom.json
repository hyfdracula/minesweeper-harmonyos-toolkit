        {"act": "reset"},
        {"act": "menu", "top": "game", "entry": "自定义"},
        {"act": "wait", "ms": 300},
        {"act": "expect", "type": "changed", "region": {"space": "custom", "x": 136, "y": 50, "w": 40, "h": 13}},
        {"act": "expect", "type": "changed", "region": {"space": "custom", "x": 136, "y": 80, "w": 40, "h": 13}},
        {"act": "expect", "type": "changed", "region": {"space": "custom", "x": 136, "y": 110, "w": 40, "h": 13}},
        {"act": "shot", "name": "custom_menu_open"}
      ]
    },

