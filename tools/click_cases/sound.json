    {
      "id": "sound.lose.bomb_sequence",
      "desc": "踩雷判负：爆炸三段（开始 → 中 → 结束）依次播出",
      "_说明": [
        "顺序也要对：开始 → 中 → 结束。",
        "「中」是循环音，所以可能不止一条；结束音在级联炸完时响。"
      ],
      "steps": [
        {
          "act": "reset"
        },
        {
          "act": "wait",
          "ms": 1800
        },
        {
          "act": "lose_game"
        },
        {
          "act": "wait",
          "ms": 3000
        },
        {
          "act": "expect",
          "type": "hilog_checks",
          "checks": [
            {
              "present": true,
              "re": "\\[Sound\\] (对齐播放|播放) mineBombStart"
            },
            {
              "present": true,
              "re": "\\[Sound\\] (对齐播放|播放) mineBombRun"
            },
            {
              "present": true,
              "re": "\\[Sound\\] (对齐播放|播放) mineBombEnd"
            }
          ]
        },
        {
          "act": "shot",
          "name": "sound_lose"
        }
      ],
      "critical": true
    },
    {
      "id": "sound.lose.per_mine_boom",
      "desc": "判负：**每颗雷各炸一声**（原版语义），不是只响一声",
      "_说明": [
        "原版是逐雷爆点：环走到哪颗雷，哪颗雷就炸一声，声音**叠着响**",
        "（linux 复刻 BoardWidget.cpp:305-306：「环走到这颗雷时才 emit mineTripped」",
        "  —— 那就是原版的音画同步机制）。",
        "所以 gameLose 的命中次数应该 **≥ 2**（级联里至少两颗雷）。",
        "只响一声是本项目的旧行为（SOUND-AUDIT.md §2 记的取舍，",
        "  理由是「没做级联动画」—— 那个理由现在已经不成立了）。"
      ],
      "steps": [
        {
          "act": "reset"
        },
        {
          "act": "wait",
          "ms": 1800
        },
        {
          "act": "lose_game"
        },
        {
          "act": "wait",
          "ms": 3000
        },
        {
          "act": "expect",
          "type": "hilog_checks",
          "checks": [
            {
              "present": true,
              "re": "\\[Sound\\] (对齐播放|播放) gameLose",
              "min_count": 2
            }
          ]
        },
        {
          "act": "shot",
          "name": "sound_lose_per_mine"
        }
      ],
      "critical": true
