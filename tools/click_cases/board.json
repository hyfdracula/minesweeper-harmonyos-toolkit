{
  "domain": "board",
  "_说明": [
    "触摸路由对位：点哪一格，被翻开的就是哪一格。",
    "每条用例都重新开局（reset），这样点的是一局里的**第一点**——",
    "第一点一定翻开被点的那格（首点安全规则 + 洪水填充从这里开始），",
    "断言是确定的，不受雷的分布影响。",
    "board 空间用 cell=[行,列]（行 0 在上、列 0 在左），点的是格中心。",
    "区域用 space=board + cell + w/h（w/h 的单位是**格**）。"
  ],
  "cases": [
    {
      "id": "board.first_click",
      "desc": "第一点开局：点(4,4)，被翻开的就是(4,4)，周围洪水填充",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [4, 4]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [4, 4]},
        {"act": "shot", "name": "board_first_click"}
      ]
    },
    {
      "id": "board.cell.00",
      "desc": "触摸路由对位：点(0,0)格，翻开的是(0,0)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [0, 0]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [0, 0]},
        {"act": "shot", "name": "board_cell_00"}
      ]
    },
    {
      "id": "board.cell.04",
      "desc": "触摸路由对位：点(0,4)格，翻开的是(0,4)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [0, 4]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [0, 4]},
        {"act": "shot", "name": "board_cell_04"}
      ]
    },
    {
      "id": "board.cell.08",
      "desc": "触摸路由对位：点(0,8)格，翻开的是(0,8)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [0, 8]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [0, 8]},
        {"act": "shot", "name": "board_cell_08"}
      ]
    },
    {
      "id": "board.cell.40",
      "desc": "触摸路由对位：点(4,0)格，翻开的是(4,0)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [4, 0]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [4, 0]},
        {"act": "shot", "name": "board_cell_40"}
      ]
    },
    {
      "id": "board.cell.44",
      "desc": "触摸路由对位：点(4,4)格，翻开的是(4,4)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [4, 4]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [4, 4]},
        {"act": "shot", "name": "board_cell_44"}
      ]
    },
    {
      "id": "board.cell.48",
      "desc": "触摸路由对位：点(4,8)格，翻开的是(4,8)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [4, 8]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [4, 8]},
        {"act": "shot", "name": "board_cell_48"}
      ]
    },
    {
      "id": "board.cell.80",
      "desc": "触摸路由对位：点(8,0)格，翻开的是(8,0)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [8, 0]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [8, 0]},
        {"act": "shot", "name": "board_cell_80"}
      ]
    },
    {
      "id": "board.cell.84",
      "desc": "触摸路由对位：点(8,4)格，翻开的是(8,4)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [8, 4]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [8, 4]},
        {"act": "shot", "name": "board_cell_84"}
      ]
    },
    {
      "id": "board.cell.88",
      "desc": "触摸路由对位：点(8,8)格（棋盘最右下角），翻开的是(8,8)",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [8, 8]},
        {"act": "wait", "ms": 1500},
        {"act": "expect", "type": "cell_opened", "cell": [8, 8]},
        {"act": "shot", "name": "board_cell_88"}
      ]
    },
    {
      "id": "board.outside.no_open",
      "desc": "点棋盘之外的区域（棋盘上方那条空白）不应翻开任何格子",
      "_注": "用 **board 空间的负数行**（cell[行] = -1）表示棋盘上方那一行，坐标跟着棋盘走，换设备也准；写死屏幕坐标的话在 Mate X7 上会点进棋盘里（那里棋盘更大）。",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [-1, 4]},
        {"act": "wait", "ms": 800},
        {"act": "expect", "type": "unchanged", "region": {"space": "board", "cell": [0, 0], "w": 9, "h": 9}},
        {"act": "shot", "name": "board_outside_no_open"}
      ]
    },
    {
      "id": "board.statusbar.no_open",
      "desc": "点状态条区域（棋盘下方那一行，也就是状态条）不应翻开任何格子",
      "_注": "同样用 board 空间的第 9 行（棋盘下面那行 = 状态条），坐标跟着棋盘走。",
      "steps": [
        {"act": "reset"},
        {"act": "tap", "space": "board", "cell": [9, 4]},
        {"act": "wait", "ms": 800},
        {"act": "expect", "type": "unchanged", "region": {"space": "board", "cell": [0, 0], "w": 9, "h": 9}},
        {"act": "shot", "name": "board_statusbar_no_open"}
      ]
    },
    {
      "id": "board.counter.timer",
      "desc": "状态条计数器：点开一格之后**计时器开始走**，而雷数不变（没插旗）",
      "_注": "2026-11-01 加。计数器是**程序画的七段数码管**（不是字体），\n      面板的位置随棋盘宽度变，所以断言区域用 strip 空间（跑测器从当前帧里\n      找出那两个绿色面板，不写死坐标）。panel 0 = 计时，panel 1 = 雷数。",
      "steps": [
        {"act": "reset"},
        {"act": "expect", "type": "counter", "region": {"space": "strip", "panel": 1}, "value": "10"},
        {"act": "tap", "space": "board", "cell": [4, 4]},
        {"act": "wait", "ms": 2500},
        {"act": "expect", "type": "changed", "region": {"space": "strip", "panel": 0}},
        {"act": "expect", "type": "unchanged", "region": {"space": "strip", "panel": 1}},
        {"act": "shot", "name": "board_counter_timer"}
      ]
    },
    {
      "id": "board.counter.negative",
      "desc": "状态条计数器：插的旗比雷还多时，**剩余雷数显示为负**（初级 10 雷 → 插 11 面旗 → 显示 -1）",
      "_注": "SPEC §3.3：剩余雷数可以为负。原版负号占紧挨数字左边的那一槽（七段里的独立负号段）。\n      这条用例要求数码管反解能读出负号（掩码 0x40，单根中横）——\n      不然「有没有变」的断言根本发现不了负号画错（Codex 复审 P2）。",
      "steps": [
        {"act": "reset"},
        {"act": "expect", "type": "counter", "region": {"space": "strip", "panel": 1}, "value": "10"},
        {"act": "longpress", "space": "board", "cell": [0, 0]},
        {"act": "longpress", "space": "board", "cell": [1, 0]},
        {"act": "longpress", "space": "board", "cell": [2, 0]},
        {"act": "longpress", "space": "board", "cell": [3, 0]},
        {"act": "longpress", "space": "board", "cell": [4, 0]},
        {"act": "longpress", "space": "board", "cell": [5, 0]},
        {"act": "longpress", "space": "board", "cell": [6, 0]},
        {"act": "longpress", "space": "board", "cell": [7, 0]},
        {"act": "longpress", "space": "board", "cell": [8, 0]},
        {"act": "longpress", "space": "board", "cell": [0, 1]},
        {"act": "longpress", "space": "board", "cell": [1, 1]},
        {"act": "wait", "ms": 800},
        {"act": "expect", "type": "counter", "region": {"space": "strip", "panel": 1}, "value": "-1"},
        {"act": "shot", "name": "board_counter_negative"}
      ]
    },
    {
      "id": "board.counter.flag",
      "desc": "状态条计数器：长按插一面旗，**雷数从 10 减到 9**（计时器不该动：还没开局）",
      "_注": "长按插旗走 uitest 的极慢 swipe（设备当成按住不动 → onLongPress）。\n      雷数用「计数器读数」断言 10 → 9，不是只看「有没有变」——数字从 10 变成 11\n      也是「变了」，那种断言太弱（Codex 复审 P2）。",
      "steps": [
        {"act": "reset"},
        {"act": "expect", "type": "counter", "region": {"space": "strip", "panel": 1}, "value": "10"},
        {"act": "longpress", "space": "board", "cell": [0, 0]},
        {"act": "wait", "ms": 1200},
        {"act": "expect", "type": "counter", "region": {"space": "strip", "panel": 1}, "value": "9"},
        {"act": "expect", "type": "unchanged", "region": {"space": "strip", "panel": 0}},
        {"act": "shot", "name": "board_counter_flag"}
      ]
    }
  ]
}
